# Copy to .env.local for local testing, or set these in Vercel → Project → Settings → Environment Variables.
# All are optional: with none set, the game runs with no analytics and localhost links.

# Your public address, used in link previews and share links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://japagame.ng

# Pick ONE analytics provider (or both):
# Plausible: cookieless, simple dashboard, paid after trial. The domain you added in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# PostHog: free tier, funnels and retention. Project API key (starts with phc_) and region host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Or your own database: Supabase project URL + anon key (run docs/analytics-schema.sql first; RLS is insert-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
